# ----------------------------------------------------------------------------------#
# Document: .gitignore
# Description: Minimalist shell tracking. Everything else is VISIBLE.
# ----------------------------------------------------------------------------------#

# --- UNIVERSAL APPS SHELL ---
apps/*/**
!apps/*/

# --- UNIVERSAL DATA SHELL ---
data/**
!data/
!data/.gitkeep

# --- PYTHON RUNTIME TRASH ---
**/__pycache__/
**/*.py[cod]
.env
.env.*

# --- PROVISIONING BUFFER ---
.tmp_models/
.hf-cli/

# --- OS & IDE SPECIFIC ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log