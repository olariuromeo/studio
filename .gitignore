# ----------------------------------------------------------------------------------#
# Document: .gitignore
# Description: Prevents heavy assets, sessions, and environment secrets from
#              polluting the Coozila! Studio repository.
# ----------------------------------------------------------------------------------#

# --- 🚀 CLONED APPLICATIONS ---
# Ignore third-party apps (Open-WebUI, ComfyUI, etc.)
apps/

# --- 💾 PERSISTENT DATA & ASSETS ---
# Main data volume for sessions, metadata, and user project storage
data/

# Local temporary assets and outputs
sessions/
exports/
temp_assets/
*.mp4
*.gif
*.wav
*.mp3

# --- 🐍 PYTHON ENVIRONMENT ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.env

# --- 🖥️ OS SPECIFIC ---
.DS_Store
Thumbs.db