# Document: .env
# Description: Local Environment Configuration for Coozila! Studio v4.0.
# ----------------------------------------------------------------------------------#

# === 1. Hardware & Runtime ===
# Set your target CUDA version based on your GPU (e.g., 11.8, 12.1, 12.4). 
# The installer will automatically map this to the correct PyTorch repository.
CUDA_VERSION=12.4
VRAM_MODE=lowvram

# === 2. Runtime Versions (ASDF Driven) ===
COMFY_PYTHON_VERSION=3.11.9
WEBUI_PYTHON_VERSION=3.11.14
STUDIO_NODE_VERSION=20.18.1

# === 3. Stable Release Tags ===
COMFY_TAG=v0.18.3
WEBUI_TAG=v0.8.12

# === 4. Network Configuration ===
STUDIO_PORT=3000
ENGINE_PORT=8188