# ----------------------------------------------------------------------------------#
# Document: .env.dev
# Description: Local Environment Overrides for Coozila! Studio v4.1 (Dev Mode).
# ----------------------------------------------------------------------------------#

# ==================================================================================#
# I. CORE SYSTEM & HARDWARE
# ==================================================================================#
# Optimized for RTX 3080 / 64GB RAM
CUDA_VERSION=13.0
VRAM_MODE=--lowvram
CUDA_TAG=cu130
COMFY_ARGS="--fp16-vae --fp16-text-enc --reserve-vram 0.5 --enable-manager"

# Runtime Versions (ASDF Driven)
COMFY_PYTHON_VERSION=3.11.9
WEBUI_PYTHON_VERSION=3.11.14
WEBUI_NODE_VERSION=22.13.0

# ==================================================================================#
# II. NETWORK, SECURITY & API KEYS
# ==================================================================================#
STUDIO_PORT=3000
ENGINE_PORT=8188
STUDIO_BASE_URL=http://127.0.0.1:8000

INTERNAL_TOKEN=your_secure_token_here
HF_TOKEN=your_huggingface_token_here
# Disable interactive HF CLI update prompts
HF_HUB_DISABLE_UPDATE_AT_LAUNCH=1
OPEN_TERMINAL_API_KEY=your_open_terminal_api_key_here

# ==================================================================================#
# III. STUDIO ECOSYSTEM (MAIN APPS & SUBMODULES)
# ==================================================================================#

# --- 1. WEBUI ECOSYSTEM (FRONTEND) ---
WEBUI_REPO="https://github.com/kabballa/open-webui.git"
WEBUI_DIR="apps/open-webui"
WEBUI_BRANCH="dev"
WEBUI_VENV="apps/open-webui/venv"

# --- 2. COMFYUI ECOSYSTEM (ENGINE) ---
COMFY_REPO="https://github.com/comfy-org/ComfyUI.git"
COMFY_DIR="apps/ComfyUI"
COMFY_TAG="v0.18.3"

    # -> Submodule: ComfyUI Manager
    MANAGER_REPO="https://github.com/Comfy-Org/ComfyUI-Manager.git"
    MANAGER_DIR="apps/ComfyUI-Manager"
    MANAGER_TAG="4.1"

    # -> Submodule: Wan 2.2 Video Wrapper
    WAN_REPO="https://github.com/kijai/ComfyUI-WanVideoWrapper.git"
    WAN_REPO_DIR="apps/ComfyUI-WanVideoWrapper"

    # -> Submodule: HeartMuLA (Audio/Music Engine)
    HEARTMULA_REPO="https://github.com/benjiyaya/HeartMuLa_ComfyUI"
    HEARTMULA_DIR="apps/HeartMuLa_ComfyUI"

# --- 3. OTIO ECOSYSTEM (TIMELINE) ---
OTIO_REPO="https://github.com/kabballa/otio.git"
OTIO_DIR="apps/otio"
OTIO_TAG="v0.18.1"
OTIO_BRANCH="main"

    # -> Submodule: OTIO Viewer
    VIEWER_REPO="https://github.com/kabballa/otioview.git"
    VIEWER_DIR="apps/otioview"

# --- 4. OPEN TERMINAL (DEV TOOLS) ---
OPEN_TERMINAL_REPO=https://github.com/kabballa/open-terminal.git
OPEN_TERMINAL_HOME=apps/open-terminal
OPEN_TERMINAL_WORKSPACE=.dev

# ==================================================================================#
# IV. INFRASTRUCTURE & DISTRIBUTED SERVICES
# ==================================================================================#

# --- Data & Storage (MinIO/S3) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=coozila_admin
S3_SECRET_KEY=coozila_secure_password
S3_BUCKET_PRODUCTION=production-assets
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Databases & Registries ---
VECTOR_DB_URL=http://qdrant-server:6333
RELATIONAL_DB_URL=postgresql://user:pass@localhost:5432/coozila
UPSCALER_URL=local
INTERPOLATION_URL=http://192.168.1.50:8001

# --- Distributed Control Plane (MCP) ---
MCP_PROXY_URL=http://127.0.0.1:8000/v1/mcp
MCP_INTERNAL_TOKEN=sk_coozila_prod_42_static_token
MCP_STUDIO_HOST=http://mcp-studio:8080
MCP_SEARCH_HOST=http://mcp-search:8081

# ==================================================================================#
# V. STUDIO ENGINE LOGIC & RULES
# ==================================================================================#

# Directories
DEBUG=true
LOGS_DIR="logs"
DATA_DIR="data"
OUTPUT_DIR="./exports"
SESSION_DIR="./sessions"

# OTIO State Manifest
OTIO_MANIFEST_DIR="blueprints"
OTIO_DEFAULT_FPS=24.0
OTIO_AUTO_SAVE=true

# State Polling (UI & Studio Watcher)
POLLING_INTERVAL_MS=2000
STUDIO_WATCHER_BATCH_SIZE=5

# Validation & Alignment (64n Rule)
FORCE_64N_ALIGNMENT=true
DEFAULT_RENDER_WIDTH=1920
DEFAULT_RENDER_HEIGHT=1088