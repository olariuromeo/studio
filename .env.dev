# Document: .env.dev
# Description: Local Environment Overrides for Coozila! Studio v4.1 (Dev Mode).
# ----------------------------------------------------------------------------------#

# === 1. Hardware & Runtime ===
# Optimizat pentru RTX 3080 / 64GB RAM
CUDA_VERSION=12.4
VRAM_MODE=highvram
CUDA_TAG=cu124

# === 2. Runtime Versions (ASDF Driven) ===
COMFY_PYTHON_VERSION=3.11.9
WEBUI_PYTHON_VERSION=3.11.14
WEBUI_NODE_VERSION=22.13.0

# === 3. Development Repositories ===
# Tragem direct din fork-ul tău custom
WEBUI_REPO="https://github.com/kabballa/open-webui.git"
WEBUI_BRANCH="dev"

# === 4. Stable Tags & Internal Paths ===
COMFY_TAG=v0.18.3
OTIO_TAG=v0.18.1

# === 5. Network Configuration ===
STUDIO_PORT=3000
ENGINE_PORT=8188

# === 6. Security & API Keys ===
HF_TOKEN=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

# === 7. Debugging ===
DEBUG=true

# === 8. Internal Paths (Coozila! Structure) ===
# Definirea folderului de logs relativ la rădăcina Studio
LOGS_DIR="logs"
DATA_DIR="data"

# === 9. OTIO Custom Ecosystem ===
OTIO_CUSTOM_REPO="https://github.com/kabballa/otio.git"
VIEWER_CUSTOM_REPO="https://github.com/kabballa/otioview.git"
OTIO_BRANCH="main"